{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run docs)",
      "Bash(npm run build)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(node --test *)",
      "Bash(npm run dev -- --mock)",
      "Bash(npm run dev:mock)"
    ],
    "deny": [
      "Bash(npm run release *)",
      "Bash(npm run sync *)",
      "Read(./.keelson/**)",
      "Read(~/.keelson/**)",
      "Read(./.edgewatch/**)",
      "Read(~/.edgewatch/**)"
    ]
  }
}
