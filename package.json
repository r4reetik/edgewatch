{
  "name": "keelson",
  "version": "0.9.0",
  "private": true,
  "description": "Security posture and best-practice tracker for Cloudflare, Vercel and AWS. Read-only, self-hosted, shipped as a Docker image.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch src/bin.ts --no-open --data-dir .keelson",
    "dev:mock": "node --watch dev/mock/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docs": "node scripts/docs.ts",
    "release": "node scripts/release.ts release",
    "sync": "node scripts/release.ts sync",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/kumo": "2.18.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "allowScripts": {
    "fsevents": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r4reetik/keelson.git"
  },
  "homepage": "https://github.com/r4reetik/keelson#readme",
  "bugs": {
    "url": "https://github.com/r4reetik/keelson/issues"
  },
  "author": "Keelson contributors",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/r4reetik"
  }
}
