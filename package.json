{
  "name": "edgewatch",
  "version": "0.8.0",
  "description": "Security posture and best-practice tracker for Cloudflare, Vercel and AWS. Read-only, runs locally.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "edgewatch": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cloudflare",
    "vercel",
    "aws",
    "security",
    "posture",
    "cspm",
    "audit",
    "compliance",
    "dns",
    "waf",
    "zero-trust",
    "self-hosted"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch src/bin.ts --no-open --data-dir .edgewatch",
    "dev:mock": "node --watch dev/mock/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docs": "node scripts/docs.ts",
    "release": "node scripts/release.ts release",
    "sync": "node scripts/release.ts sync",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/bin.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/kumo": "2.17.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "fsevents": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r4reetik/edgewatch.git"
  },
  "homepage": "https://github.com/r4reetik/edgewatch#readme",
  "bugs": {
    "url": "https://github.com/r4reetik/edgewatch/issues"
  },
  "author": "Edgewatch contributors",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/r4reetik"
  }
}
